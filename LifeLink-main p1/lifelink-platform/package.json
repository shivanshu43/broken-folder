{
  "name": "lifelink-platform",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@lifelink/web",
    "dev:api": "npm run dev --workspace=@lifelink/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:organ-demo": "node --import tsx scripts/seed-organ-demo.ts",
    "seed:indore-organ-demo": "node --env-file-if-exists=.env --require ./tests/tsx-userinfo-preload.cjs --import tsx scripts/seed-indore-organ-demo.ts",
    "test": "node --require ./tests/tsx-userinfo-preload.cjs --import tsx --test tests/unit/workflow.test.ts tests/unit/inventory.test.ts tests/unit/security-realtime.test.ts tests/unit/organ-coordination.test.ts tests/unit/rag.test.ts tests/integration/blood-workflow.test.ts",
    "rag:index": "node --env-file-if-exists=.env --require ./tests/tsx-userinfo-preload.cjs --import tsx scripts/index-rag-knowledge.ts"
  }
}
